{
	"name": "postman2api",
	"main": "src/index.ts",
	"compatibility_date": "2024-09-23",
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "postman2api",
			"database_id": "03980aeb-17c6-4333-9d7d-e09119213ba4",
			"migrations_dir": "migrations"
		}
	],
	"assets": {
		"directory": "./dashboard/dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": true
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "WS_HUB",
				"class_name": "WSHub"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"WSHub"
			]
		}
	],
	"triggers": {
		"crons": [
			"*/15 * * * *"
		]
	}
}