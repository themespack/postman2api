{
  "name": "postman2api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "setup": "bun scripts/setup.ts",
    "deploy": "bun scripts/setup.ts",
    "dev": "wrangler dev",
    "deploy:worker-only": "wrangler deploy",
    "build": "cd dashboard && bun install && bun run build",
    "typecheck": "bunx tsc --noEmit",
    "typecheck:bun": "bunx tsc --noEmit -p tsconfig.bun.json",
    "cli": "bun src/cli.ts",
    "db:migrations:local": "wrangler d1 migrations apply DB --local",
    "db:migrations:remote": "wrangler d1 migrations apply DB --remote",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.17"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.8.0",
    "wrangler": "^4.0.0"
  }
}
